generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum ShopSubscriptionStatus {
  ACTIVE
  SUSPENDED
}

// One row per client business. Every tenant-owned model below carries a
// shopId so one shared app + one shared database can serve many coffee
// shops with each shop's data isolated by row (see the multi-tenant retrofit
// plan). subscriptionStatus is the kill switch: requireActiveShop
// middleware rejects any request for a SUSPENDED shop, and login()/refresh()
// in auth.service.ts also check it directly so a suspended shop's staff
// can't even sign in. nextOrderSequence backs per-shop receipt numbering
// (see Order.sequenceNumber below) since a single global Postgres SERIAL
// would interleave confusing order numbers across shops.
model Shop {
  id                 String                 @id @default(cuid())
  name               String
  logoUrl            String?
  subscriptionStatus ShopSubscriptionStatus @default(ACTIVE)
  suspendedAt        DateTime?              @db.Timestamptz(3)
  suspendedReason    String?
  nextOrderSequence  Int                    @default(1)
  users              User[]
  categories         Category[]
  products           Product[]
  modifiers          Modifier[]
  discounts          Discount[]
  orders             Order[]
  auditLogs          AuditLog[]
  expenses           Expense[]
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
}

model User {
  id                    String                 @id @default(cuid())
  shopId                String
  shop                  Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  name                  String
  email                 String                 @unique
  passwordHash          String
  role                  Role                   @default(CASHIER)
  isActive              Boolean                @default(true)
  inventoryTransactions InventoryTransaction[]
  orders                Order[]
  voidedOrders          Order[]                @relation("OrderVoidedBy")
  auditLogs             AuditLog[]
  expenses              Expense[]
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)

  @@index([role])
  @@index([shopId])
}

enum AuditAction {
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRICE_CHANGED
  INVENTORY_ADJUSTED
  USER_CREATED
  USER_DISABLED
  USER_REACTIVATED
  USER_PASSWORD_RESET
  ROLE_CHANGED
  DISCOUNT_CREATED
  DISCOUNT_UPDATED
  CONFIG_CHANGED
  ORDER_CANCELLED
  ORDER_REFUNDED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
}

// Append-only: no route ever exposes update or delete for this model, at any
// role — admins can only ever create (implicitly, via the actions below) and
// view. previousState/newState are loose Json snapshots (shape varies per
// action) rather than a strict schema, matching this table's role as a
// human-readable trail, not a source of truth to rebuild state from.
model AuditLog {
  id            String      @id @default(cuid())
  shopId        String
  shop          Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  actorId       String
  actor         User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorName     String
  action        AuditAction
  resource      String
  resourceId    String
  previousState Json?
  newState      Json?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  // createdAt backs the default (unfiltered) and date-range-only query shape
  // that listAuditLogs' ORDER BY createdAt DESC always uses — mirrors the
  // standalone Order.createdAt index added for the same reason.
  @@index([createdAt])
  @@index([action, createdAt])
  // resource+createdAt backs today's "filter by resource" query;
  // resource+resourceId is kept for a plausible future "history for this
  // specific entity" view, not used by any query yet.
  @@index([resource, createdAt])
  @@index([resource, resourceId])
  // Forward-looking: no "actions by this actor" filter exists yet, but this
  // is the natural index for one when it's added.
  @@index([actorId, createdAt])
  @@index([shopId, createdAt])
}

// name is NOT unique at the DB level: uniqueness is enforced only among
// active rows, at the service layer (see category.service.ts). A plain
// @unique here would permanently reserve a deactivated category's name,
// which contradicts the soft-delete-only design (see Product's note below).
// name is unique among active rows only, via a hand-written partial index
// (Category_name_active_key, see the migrations directory) — Prisma's schema
// DSL can't express partial unique indexes. This permits an inactive
// (soft-deleted) category to keep its historical name while a new active
// category reuses it.
model Category {
  id        String     @id @default(cuid())
  shopId    String
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Restrict)
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  products  Product[]
  // Optional self-relation so a category can be a sub-category of another
  // top-level one (e.g. "Espresso" under "Coffee"). Null parentId means
  // top-level. Only one level deep is used by the app today — nothing
  // enforces that in the schema, it's just the only shape the UI builds.
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([isActive])
  @@index([parentId])
  @@index([shopId])
}

// Prices are stored as integer cents everywhere in the catalog to avoid
// floating-point rounding errors. Deactivation (isActive) is the only
// deletion mechanism — rows are never hard-deleted once they could be
// referenced by a historical order, so past receipts never change when a
// product/variant/modifier is edited or retired later.
//
// basePrice vs. variant price: basePrice is the product's price ONLY when
// it has no active variants (e.g. a drip coffee sold in one size). Once a
// product has variants (e.g. Latte: Small/Medium/Large), each variant's
// `price` is the full price for that size — basePrice is then unused by
// ordering logic, not a base added to variant price.
model Product {
  id          String            @id @default(cuid())
  shopId      String
  shop        Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  categoryId  String
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  description String?
  basePrice   Int
  isActive    Boolean           @default(true)
  // Admin-uploaded photo, served from this API's own /uploads static mount
  // (see product-image.service.ts). Null until an admin uploads one — the
  // frontend falls back to a name-matched stock photo, then a generic icon.
  imageUrl    String?
  variants    ProductVariant[]
  modifiers   ProductModifier[]
  inventory   InventoryItem?
  orderItems  OrderItem[]
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@index([isActive])
  @@index([shopId])
}

// [productId, name] is unique among active rows only, via a hand-written
// partial index (ProductVariant_productId_name_active_key) — same
// soft-delete reasoning as Category.name above.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String
  price     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([productId, name])
  @@index([productId])
}

// name is unique among active rows only, via a hand-written partial index
// (Modifier_name_active_key) — same soft-delete reasoning as Category.name
// above.
model Modifier {
  id        String            @id @default(cuid())
  shopId    String
  shop      Shop              @relation(fields: [shopId], references: [id], onDelete: Restrict)
  name      String
  price     Int
  isActive  Boolean           @default(true)
  products  ProductModifier[]
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([isActive])
  @@index([shopId])
}

// The join row itself carries no historical significance (unlike Product/
// Variant/Modifier rows), so it's safe to hard-delete and re-create freely.
model ProductModifier {
  productId  String
  modifierId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifier   Modifier @relation(fields: [modifierId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@id([productId, modifierId])
  @@index([modifierId])
}

enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  WASTE
  SALE
}

// One inventory record per product (not per variant — see Product's
// basePrice/variant note for the same simplification rationale). Every
// created Product gets an InventoryItem automatically (see
// product.service.ts createProduct) so it's always ready for stock
// operations and, later, checkout deduction.
model InventoryItem {
  id             String                 @id @default(cuid())
  productId      String                 @unique
  product        Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityOnHand Int                    @default(0)
  reorderLevel   Int                    @default(0)
  transactions   InventoryTransaction[]
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  @@index([quantityOnHand])
}

// Append-only audit log — never updated or deleted. Every stock change,
// whatever the cause, must produce exactly one row here in the same
// database transaction as the InventoryItem update, so quantityOnHand can
// always be reconstructed/verified from history. `quantityAfter` snapshots
// the resulting stock level so history reads don't need to replay deltas.
// `idempotencyKey` lets a caller (e.g. a future checkout flow deducting
// stock for an order) safely retry the same operation without double-
// applying it — a second call with the same key is a no-op that returns
// the original transaction. Scoped to (inventoryItemId, idempotencyKey),
// NOT globally unique: a caller like a future checkout deducting several
// different products for one order will naturally want to reuse the same
// key (e.g. the order id) across each product's own inventory operation —
// a global unique would make the second product's deduction silently no-op
// and report success without ever touching that product's stock.
model InventoryTransaction {
  id              String                   @id @default(cuid())
  // Denormalized (not just reachable via inventoryItem->product) because
  // reports.service.ts's getInventoryMovementReport queries this table
  // directly with raw SQL — Prisma's query-builder ownership checks don't
  // apply to raw SQL, so the filter needs a column to reach directly.
  shopId          String
  inventoryItemId String
  inventoryItem   InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  type            InventoryTransactionType
  quantityChange  Int
  quantityAfter   Int
  reason          String?
  idempotencyKey  String?
  createdByUserId String
  createdBy       User                     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)

  @@unique([inventoryItemId, idempotencyKey])
  @@index([inventoryItemId, createdAt])
  @@index([createdByUserId])
  // The inventory-movement report scans across ALL items by date range
  // (and optionally by type), unlike the per-item index above.
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([shopId, createdAt])
}

enum PaymentMethod {
  CASH
}

enum OrderStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// name is unique among active rows only, via a hand-written partial index
// (Discount_name_active_key) — same soft-delete reasoning as
// Category/Modifier/ProductVariant above. `value` is a percentage point
// (0-100) when type is PERCENTAGE, or integer cents when type is FIXED.
// `expiresAt` is optional — a discount with no expiry is valid indefinitely
// while isActive.
model Discount {
  id        String       @id @default(cuid())
  shopId    String
  shop      Shop         @relation(fields: [shopId], references: [id], onDelete: Restrict)
  name      String
  type      DiscountType
  value     Int
  isActive  Boolean      @default(true)
  expiresAt DateTime?    @db.Timestamptz(3)
  orders    Order[]
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@index([name])
  @@index([isActive])
  @@index([shopId])
}

// A shop's operating cost (rent, supplies, utilities, payroll, etc.) — kept
// separate from Order/OrderItem, which record revenue, not spend. amount is
// integer cents like every other money field in this schema. category is a
// free-text string rather than an enum/lookup table — the set of categories
// a shop wants (rent, utilities, ingredients...) varies enough between shops
// that a fixed enum would need constant edits; the admin UI offers common
// suggestions but doesn't enforce them.
model Expense {
  id              String   @id @default(cuid())
  shopId          String
  shop            Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  description     String
  category        String
  amount          Int
  incurredAt      DateTime @db.Timestamptz(3)
  note            String?
  createdByUserId String
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@index([shopId])
  @@index([incurredAt])
  @@index([category])
}

// The financial record of a completed sale. subtotal/discountAmount/total
// are always server-computed at checkout time from live catalog data — the
// frontend never supplies them. idempotencyKey makes checkout safe to retry
// (double-click, network retry) without creating a duplicate order.
//
// sequenceNumber is a Postgres SERIAL, which is NOT transactional: a
// rolled-back checkout attempt (e.g. insufficient stock) still permanently
// consumes a sequence value, leaving a gap with no corresponding row. This
// is expected and accepted — analogous to voided-receipt gaps in
// traditional POS systems — not a bug to "fix" by pre-checking availability
// before allocating a number.
model Order {
  id                   String      @id @default(cuid())
  // Scoped per-shop (not a global Postgres SERIAL) so each shop's receipts
  // read as a clean, gapless-per-shop sequence instead of interleaving with
  // other shops' order numbers. Assigned by the app inside checkout's
  // transaction from Shop.nextOrderSequence, under a FOR UPDATE lock on the
  // Shop row — see checkout.service.ts. No DB default: the app always sets
  // this explicitly.
  sequenceNumber       Int
  shopId               String
  shop                 Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  cashierId            String
  cashier              User        @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  status               OrderStatus @default(COMPLETED)
  subtotal             Int
  discountId           String?
  // Snapshots the discount's name at checkout time — same rationale as
  // OrderItem's *Snapshot fields. discountAmount alone preserves the
  // correct historical total, but without this the receipt's discount
  // *label* would silently follow a later rename, or go blank if the
  // discount is ever deleted (discountId -> SetNull).
  discountNameSnapshot String?
  discount             Discount?   @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountAmount       Int         @default(0)
  total                Int
  notes                String?
  idempotencyKey       String      @unique
  items                OrderItem[]
  payment              Payment?
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  // Set together, only when status transitions COMPLETED -> CANCELLED or
  // COMPLETED -> REFUNDED (admin-only, see order.service.ts's voidOrder).
  // All three are null for the common case (a completed sale that was never
  // reversed). onDelete: Restrict, same rationale as `cashier` above — the
  // admin who voided a sale is part of its permanent history.
  voidedAt             DateTime?   @db.Timestamptz(3)
  voidedById           String?
  voidedBy             User?       @relation("OrderVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason           String?

  @@unique([shopId, sequenceNumber])
  @@index([cashierId, createdAt])
  @@index([discountId])
  // Dashboard/report queries scan across ALL cashiers by date range, so the
  // cashier-scoped index above can't serve them. status+createdAt backs the
  // cancelled/refunded-orders report's combined filter directly.
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([shopId, createdAt])
}

// Snapshots product/variant name and unit price at the moment of sale.
// productId is kept only for reporting/reference — display and receipts
// must always read the *Snapshot fields, never re-join to the live Product,
// so later price/name edits never alter a historical order.
model OrderItem {
  id                  String              @id @default(cuid())
  // Denormalized (not just reachable via order->shop) because
  // reports.service.ts's getProductSalesReport/getCategorySalesReport query
  // this table directly with raw SQL, which Prisma's query-builder
  // ownership checks can't protect.
  shopId              String
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  productNameSnapshot String
  variantNameSnapshot String?
  unitPriceSnapshot   Int
  quantity            Int
  lineSubtotal        Int
  modifiers           OrderItemModifier[]
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([productId])
  @@index([shopId])
}

// Purely a snapshot row — no FK to the live Modifier catalog, deliberately,
// so it can never be joined back to (and silently follow) a current price.
model OrderItemModifier {
  id                   String    @id @default(cuid())
  orderItemId          String
  orderItem            OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierNameSnapshot String
  priceSnapshot        Int

  @@index([orderItemId])
}

// One payment per order (cash-only for now). amountReceived/changeGiven are
// always server-validated/computed, never trusted from the client.
model Payment {
  id             String        @id @default(cuid())
  // Denormalized (not just reachable via order->shop) because
  // reports.service.ts's getPaymentMethodReport queries this table
  // directly with raw SQL, which Prisma's query-builder ownership checks
  // can't protect.
  shopId         String
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method         PaymentMethod @default(CASH)
  amountDue      Int
  amountReceived Int
  changeGiven    Int
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  @@index([shopId])
}
